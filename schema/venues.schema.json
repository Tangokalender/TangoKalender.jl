{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://tangokalender.github.io/schema/venues.schema.json",
    "title": "Venue coordinates",
    "description": "Cache of address → coordinates for maps (venues.json). Filled by `tangokalender geocode` from OpenStreetMap Nominatim; entries with source \"manual\" are edited by hand and never overwritten. Only precision \"house\" or manual entries are shown on maps.",
    "type": "array",
    "items": {
        "type": "object",
        "required": ["address", "lat", "lon", "precision", "source"],
        "additionalProperties": false,
        "properties": {
            "address": {"type": "string", "minLength": 1},
            "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
            "precision": {"enum": ["house", "street", "none"]},
            "source": {"enum": ["nominatim", "manual"]},
            "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "osm": {"type": "string"},
            "note": {"type": "string"}
        }
    }
}
